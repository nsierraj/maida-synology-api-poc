# Settings for the synology-mcp container (Container Manager). Copy to .env in the project folder
# on the NAS, next to docker-compose.yml. See docs/mcp-server.md, "Running in Container Manager".
# docker-compose.yml sets SYNO_MCP_TRANSPORT, SYNO_MCP_HOST and SYNO_MCP_PORT; don't set them here.
# Quote values containing $, # or spaces with single quotes: SYNO_PASS='pa$$ word'

# --- NAS connection ---
# The NAS's LAN IP. Not "localhost": inside the container, localhost is the container itself.
SYNO_HOST=192.168.1.50
SYNO_PORT=5001

# The DSM user the MCP acts as: non-admin, access only to the shares it needs,
# and "No access" on the share holding this file.
SYNO_USER=poc-user
SYNO_PASS=change-me

# TLS: pin the NAS certificate by fingerprint (the part after "=" from the openssl command in
# the README; colons are fine). Leave SYNO_CA_CERT empty: the image has no certificate files.
SYNO_CERT_SHA256=
SYNO_CA_CERT=

# --- What the MCP server may do ---
SYNO_SANDBOX=/poc-sandbox
# Folders that write and share tools may touch (comma-separated). Empty = SYNO_SANDBOX.
SYNO_MCP_ROOTS=
SYNO_MCP_ALLOW_WRITES=false
SYNO_MCP_ALLOW_SHARING=false
# Inside the container, not your computer. Leave empty unless you mount a volume (docker-compose.yml).
SYNO_MCP_LOCAL_DIR=

# --- HTTP access ---
# Clients send it as "Authorization: Bearer <token>". At least 32 characters: openssl rand -hex 32
SYNO_MCP_TOKEN=
