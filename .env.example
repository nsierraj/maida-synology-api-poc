# NAS address on your LAN (IP or hostname) and HTTPS port
SYNO_HOST=192.168.1.50
SYNO_PORT=5001

# Dedicated non-admin test user with read/write on the sandbox share only
SYNO_USER=poc-user
SYNO_PASS=change-me

# Shared folder the PoC is allowed to write into (examples refuse paths outside it)
SYNO_SANDBOX=/poc-sandbox

# TLS pinning: set ONE of these (see README).
# 1) CA/chain file exported from DSM (hostname must match the cert)
SYNO_CA_CERT=certs/synology-ca.pem
# 2) SHA-256 fingerprint of the NAS certificate (works when connecting by IP)
SYNO_CERT_SHA256=

# Optional: a path the test user should NOT be able to read (used by 02_browse negative demo)
SYNO_DENIED_PATH=/homes
